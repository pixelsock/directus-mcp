DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_ACCESS_TOKEN=your_token_here
DIRECTUS_EMAIL=your_email@example.com
DIRECTUS_PASSWORD=your_password_here

# Transport configuration
# MCP_TRANSPORT=stdio        # Default: stdio transport (for local AI editors like Cursor/Claude Desktop)
# MCP_TRANSPORT=http         # HTTP transport (for multi-user / remote deployments)
# MCP_PORT=3000              # HTTP server port (default: 3000, only used when MCP_TRANSPORT=http)
# MCP_HOST=127.0.0.1         # HTTP server host (default: 127.0.0.1, use 0.0.0.0 to bind all interfaces)
